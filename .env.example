# Copy to .env (git-ignored) or export these in your shell / server.

# Email alerts (Gmail: smtp.gmail.com + an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=you@example.com

# WhatsApp alerts via Twilio (https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+33600000000

# Web platform
TRADEBOT_API_TOKEN=change-me-to-a-long-random-string   # required when the site is public
TRADEBOT_AUTOSTART=true

# Stock market data: yahoo (free, ~15 min delayed, default) or a paid real-time feed
# (see LATER.md section 1). Yahoo stays the automatic fallback.
MARKET_DATA_PROVIDER=yahoo            # yahoo | polygon | alpaca | finnhub
POLYGON_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex                  # iex (free) | sip (paid, full market)
FINNHUB_API_KEY=
# MARKET_DATA_MAX_RPM=60              # optional request-per-minute cap
# MARKET_DATA_EXTENDED_HOURS=0        # 1 = include pre/after-market intraday bars

# Broker (see LATER.md section 2). Paper / test accounts unless TRADING_MODE=live.
TRADING_MODE=paper                    # paper | live  (live = REAL MONEY, owner only)
BROKER=paper                          # paper | alpaca | ccxt | ibkr
# Alpaca uses the same ALPACA_API_KEY_ID / ALPACA_API_SECRET_KEY as above (paper keys start with PK)
# CCXT_EXCHANGE=binance
# CCXT_API_KEY=...
# CCXT_SECRET=...
# CCXT_QUOTE=USDT
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497                      # 7497 TWS paper / 4002 Gateway paper; 7496 / 4001 live
# IBKR_CLIENT_ID=17
# Optional stricter limits (can only tighten the defaults)
# MAX_ORDER_VALUE=1000
# MAX_DAILY_LOSS_VALUE=300
# RISK_PER_TRADE_PCT=0.5
